opam-version: "2.0"
synopsis: "OCaml AT Protocol PDS admin CLI"
description: "Admin CLI for Tempest PDS."
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.13" & >= "3.13"}
  "cmdliner"
  "fmt"
  "logs"
  "cohttp-lwt-unix"
  "cmarkit" {= "0.4.0"}
  "lwt_ssl"
  "lwt_ppx"
  "mirage-crypto-rng"
  "yojson"
  "zarith"
  "uri"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]

# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml AT Protocol CLI for operating a Tempest PDS"
description:
  "A learning-friendly OCaml CLI intended to replace goat for a personal Tempest PDS."
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.13" & >= "3.13"}
  "cmdliner"
  "fmt"
  "logs"
  "cohttp-lwt-unix"
  "lwt_ppx"
  "yojson"
  "uri"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
